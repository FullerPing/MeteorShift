{
  "name": "MeteorShift",
  "tree": {
    "$className": "DataModel",
    "ReplicatedFirst": {
      "$className": "ReplicatedFirst",
      "$ignoreUnknownInstances": true,
      "LoadingScreen": { "$path": "src/loading/LoadingScreen.client.luau" }
    },
    "ReplicatedStorage": {
      "Packages": {
        "$path": "Packages"
      },
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerStorage": {
      "$ignoreUnknownInstances": true,
      "Tests": {
        "$path": "tests"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "StarterGui": {
      "$className": "StarterGui",
      "$path": "assets/native-ui",
      "$ignoreUnknownInstances": true
    }
  }
}
