--!strict
return function(t: any)
	local Layout = require(t.shared.RefineryLayout)
	local MenuFit = require(t.shared.MenuFit)
	t.test("phone refinery retains an inventory row above its footer", function()
		for _, viewport in { Vector2.new(844, 390), Vector2.new(780, 360), Vector2.new(685, 338), Vector2.new(320, 568), Vector2.new(390, 844) } do
			for _, inset in { 36, 58, 60 } do
				-- RefineryController: on MenuFit's virtual screen, under the top bar, with room for the title ribbon (26)
				-- and the lip and margin (15)
				local view = MenuFit.view(viewport, inset)
				local height = math.min(570, view.viewport.Y - view.inset - 26 - 15)
				local g = Layout.compute(height)
				t.ok(g.inventoryHeight >= 44, tostring(viewport) .. " usable inventory row")
				t.ok(g.list + g.inventoryHeight <= height - 56, "inventory clears footer")
				t.ok(g.actions + g.actionH <= g.list, "actions clear inventory")
				t.ok(g.actionH >= 44, "transaction targets remain touch sized")
			end
		end
	end)
	t.test("short refinery defers extra headings to keep the empty state clear", function()
		local g = Layout.compute(307)
		t.eq(g.hideStatus, true)
		t.eq(g.minimal, false)
		t.ok(g.list + 44 < 307 - 54, "empty-state copy clears feedback")
		t.eq(Layout.compute(570).hideStatus, false)
	end)
	t.test("roomy windows show the three-card production line and still keep the footer clear", function()
		local g = Layout.compute(570, 620)
		t.eq(g.flow, true)
		t.ok(g.actions + g.actionH <= g.totals, "cards clear the order heading")
		t.ok(g.totals + 22 <= g.list, "heading clears the list")
		t.ok(g.inventoryHeight >= g.row + 12, "at least one ore row fits above the footer")
		t.ok(g.list + g.inventoryHeight <= 570 - 56, "list clears footer")
	end)
	t.test("narrow or short windows keep the two-card layout", function()
		t.eq(Layout.compute(570, 366).flow, false)
		t.eq(Layout.compute(470, 620).flow, false)
		t.eq(Layout.compute(330, 620).flow, false)
	end)
end
